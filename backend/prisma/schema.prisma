generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  criadoEm  DateTime @default(now())

  tokenRecuperacao String?
  tokenExpiraEm    DateTime?

  empresaId Int?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  vendas           Venda[]
  movimentacoes    Movimentacao[]
  comandas         Comanda[]
}

model Empresa {
  id        Int       @id @default(autoincrement())
  nome      String
  logoUrl   String?

  vendas    Venda[]
  usuarios  Usuario[]
  mesas     Mesa[]
}

model Categoria {
  id        Int      @id @default(autoincrement())
  nome      String   @unique
  produtos  Produto[]
}

model Fornecedor {
  id        Int      @id @default(autoincrement())
  nome      String
  telefone  String?
  email     String?
  produtos  Produto[]
}

model Produto {
  id                Int      @id @default(autoincrement())
  nome              String
  codigoBarra       String?  @unique
  descricao         String?
  precoCusto        Float
  precoVenda        Float
  quantidade        Int      @default(0)
  estoqueMinimo     Int      @default(5)
  categoriaId       Int?
  fornecedorId      Int?
  criadoEm          DateTime @default(now())
  ativo             Boolean  @default(true)

  disponivelVenda   Boolean  @default(true)
  disponivelComanda Boolean  @default(false)

  categoria         Categoria?    @relation(fields: [categoriaId], references: [id])
  fornecedor        Fornecedor?   @relation(fields: [fornecedorId], references: [id])
  itensVenda        ItemVenda[]
  movimentacoes     Movimentacao[]
  itensComanda      ComandaItem[]
}

model Movimentacao {
  id               Int      @id @default(autoincrement())
  produtoId        Int
  usuarioId        Int?
  tipo             String
  quantidade       Int
  observacao       String?
  dataMovimentacao DateTime @default(now())

  produto Produto   @relation(fields: [produtoId], references: [id])
  usuario Usuario?  @relation(fields: [usuarioId], references: [id])
}
model Venda {
  id             Int      @id @default(autoincrement())
  codigo         String   @unique @default(cuid())
  usuarioId      Int
  empresaId      Int?
  comandaId      Int?     @unique

  subtotal       Float
  desconto       Float    @default(0)

  taxaServicoPercentual Float @default(0)
  taxaServico            Float @default(0)

  total          Float

  formaPagamento String
  status         String   @default("FINALIZADA")
  observacao     String?
  criadoEm       DateTime @default(now())

  usuario Usuario  @relation(fields: [usuarioId], references: [id])
  empresa Empresa? @relation(fields: [empresaId], references: [id])
  comanda Comanda? @relation(fields: [comandaId], references: [id])
  itens   ItemVenda[]
}

model ItemVenda {
  id            Int      @id @default(autoincrement())
  vendaId       Int
  produtoId     Int
  nomeProduto   String
  quantidade    Int
  precoUnitario Float
  subtotal      Float

  venda   Venda   @relation(fields: [vendaId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])
}

model Mesa {
  id          Int      @id @default(autoincrement())
  numero      Int
  capacidade  Int?
  status      String   @default("LIVRE")
  observacao  String?

  empresaId   Int?
  empresa     Empresa? @relation(fields: [empresaId], references: [id])

  comandas    Comanda[]

  criadaEm    DateTime @default(now())

  @@unique([empresaId, numero])
}

  model Comanda {
  id        Int    @id @default(autoincrement())
  codigo    String @unique @default(cuid())

  mesaId        Int?
  usuarioId     Int

  status        String   @default("ABERTA")

  observacao    String?

  taxaServicoAtiva      Boolean @default(false)
  taxaServicoPercentual Float   @default(0)

  vendaId       Int?      @unique

  criadoEm      DateTime  @default(now())
  fechadoEm     DateTime?

  mesa          Mesa?     @relation(fields: [mesaId], references: [id])
  usuario       Usuario   @relation(fields: [usuarioId], references: [id])
  venda         Venda?

  itens         ComandaItem[]
  pagamentos    Pagamento[]
}

model ComandaItem {
  id            Int      @id @default(autoincrement())

  comandaId     Int
  produtoId     Int

  quantidade       Int
  quantidadeServida Int @default(0)

  precoUnitario Float
  subtotal      Float

  observacao    String?

  status        String   @default("PENDENTE")

  cobrar            Boolean  @default(true)
  motivoNaoCobranca String?
  ajustadoEm        DateTime?

  criadoEm      DateTime  @default(now())
  enviadoEm     DateTime?
  preparandoEm  DateTime?
  prontoEm      DateTime?
  servidoEm     DateTime?

  comanda       Comanda  @relation(fields: [comandaId], references: [id])
  produto       Produto  @relation(fields: [produtoId], references: [id])
}

model Pagamento {
  id          Int      @id @default(autoincrement())

  comandaId   Int

  valor       Float
  forma       String
  status      String   @default("PAGO")

  criadoEm    DateTime @default(now())

  comanda     Comanda  @relation(fields: [comandaId], references: [id])
}